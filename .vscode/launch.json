{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "[msys] Run GUI C++ (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/gui_pc.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:/msys64/mingw64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "miDebuggerArgs": "--quiet",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Configure+Build GUI C++ (Debug)"
        },
        {
            "name": "[linux] Run GUI C++ (F5)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/gui_pc",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "--quiet",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Configure+Build GUI C++ (Debug)"
        }
    ]
}